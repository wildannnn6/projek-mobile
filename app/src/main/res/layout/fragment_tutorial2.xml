<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tambahan"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".Tutorial2Fragment">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="@string/cd_affirmation_icon"
        android:padding="30dp"
        android:src="@drawable/aff_heart" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/milesdan_trial"
        android:gravity="center"
        android:text="@string/tutorial2_title"
        android:textColor="@color/buton"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/tutorial2_desc"
        android:textColor="@color/text_utama"
        android:textSize="16sp" />
</LinearLayout>
